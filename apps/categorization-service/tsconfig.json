{
  "extends": "@expense-tracker/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@prisma/client": [
        "./node_modules/.prisma/client-categorization"
      ],
      "@core/*": [
        "../../packages/core/src/*"
      ],
      "@expense-tracker/middleware": [
        "../../packages/middleware/src"
      ],
      "@expense-tracker/middleware/*": [
        "../../packages/middleware/src/*"
      ],
      "@shared/middleware": [
        "../../packages/middleware/src"
      ],
      "@shared/middleware/*": [
        "../../packages/middleware/src/*"
      ],
      "@packages/*": [
        "../../packages/*/src"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
