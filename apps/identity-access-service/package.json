{
  "name": "@expense-tracker/identity-access-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:@prisma/client --external:bcryptjs --external:fastify --external:fastify-plugin --external:jsonwebtoken --external:pino --external:pino-pretty --external:uuid --external:zod --external:dotenv --external:@fastify/* && prisma generate",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@expense-tracker/core": "workspace:*",
    "@expense-tracker/contracts": "workspace:*",
    "@expense-tracker/outbox-kit": "workspace:*",
    "@expense-tracker/correlation": "workspace:*",
    "@expense-tracker/middleware": "workspace:*",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.1",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@expense-tracker/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.20.0",
    "prisma": "^5.9.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
