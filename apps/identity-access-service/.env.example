# ============================================
# Identity & Access Service — Configuration
# ============================================

# Service-specific database
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/expense_tracker_identity?schema=public"

# Server Port
PORT=3002

# Environment Mode (development, test, production)
NODE_ENV=development

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Internal Service-to-Service API Key (Mandatory in production)
INTERNAL_API_KEY="dev-internal-key-change-in-prod"

# Downstream Webhook Destinations
AUDIT_SERVICE_URL="http://localhost:3009"
NOTIFICATION_SERVICE_URL="http://localhost:3008"

# Password Hashing Cost
BCRYPT_ROUNDS=12

# Maintenance & Retention Settings
CLEANUP_INTERVAL_MS=3600000
OUTBOX_RETENTION_DAYS=7
