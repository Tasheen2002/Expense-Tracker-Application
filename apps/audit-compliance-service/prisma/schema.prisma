generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client-audit"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["audit_compliance"]
}

// Account lifecycle records are deliberately outside all workspace queries.
model AccountAuditLog {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(100)
  entityType String @map("entity_type") @db.VarChar(100)
  entityId String @map("entity_id") @db.Uuid
  details Json
  fingerprint String @db.VarChar(64)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("account_audit_logs")
  @@schema("audit_compliance")
}

model AuditLog {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.Uuid
  details     Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_workspace_timeline_idx")
  @@index([workspaceId, entityType, entityId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_entity_timeline_idx")
  @@index([workspaceId, userId, createdAt(sort: Desc)], map: "audit_logs_actor_timeline_idx")
  @@index([workspaceId, action, createdAt(sort: Desc)], map: "audit_logs_action_timeline_idx")
  @@map("audit_logs")
  @@schema("audit_compliance")
}
