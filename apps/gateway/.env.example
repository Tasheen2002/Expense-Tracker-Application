PORT=3001
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INTERNAL_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000
# Coarse ingress budget per client IP; downstream per-user/write limits still apply.
GATEWAY_RATE_LIMIT_MAX=300
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Actual reverse proxy socket peer IP(s), comma-separated; blank trusts none.
# Never set this to all addresses or use a hop-count trust rule.
GATEWAY_TRUSTED_PROXY_IPS=
