{
  "name": "@expense-tracker/gateway",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "node ../../scripts/lint-backend.cjs gateway",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/http-proxy": "^9.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "@expense-tracker/typescript-config": "workspace:*"
  }
}
