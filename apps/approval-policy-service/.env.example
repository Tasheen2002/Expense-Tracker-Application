# ============================================
# Approval & Policy Service — Configuration
# ============================================

# Service-specific database
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/expense_tracker_approval?schema=public"

# Server Port
PORT=3005

# Environment Mode (development, test, production)
NODE_ENV=development

# Internal Service-to-Service API Key (Mandatory in production)
INTERNAL_API_KEY="dev-internal-key-change-in-prod"

# Downstream Service URLs
IDENTITY_SERVICE_URL="http://localhost:3002"
EXPENSE_SERVICE_URL="http://localhost:3003"
AUDIT_SERVICE_URL="http://localhost:3009"
NOTIFICATION_SERVICE_URL="http://localhost:3008"

# Exemption Expiration Scheduler Interval (in ms)
EXEMPTION_EXPIRATION_INTERVAL_MS=60000

# Development Authentication Bypass (Set to "true" only in local dev without Identity running)
ENABLE_DEV_AUTH_BYPASS=false
