# ============================================
# Bank Feed Service — Configuration
# ============================================
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/expense_tracker_bank_feed?schema=public"
PORT=3006
NODE_ENV=development
INTERNAL_API_KEY="replace-with-the-shared-internal-service-key"
IDENTITY_SERVICE_URL="http://localhost:3002"
AUDIT_SERVICE_URL="http://localhost:3009"
NOTIFICATION_SERVICE_URL="http://localhost:3008"
# HTTPS endpoint accepting GET ?fromDate=<ISO>&toDate=<ISO> and a bearer access token.
# Response: {"transactions":[{"externalId":"...","amount":"12.34","currency":"USD","description":"...","transactionDate":"2026-01-01T00:00:00.000Z"}]}
BANK_FEED_PROVIDER_URL="https://your-bank-aggregator.example/api/transactions"
# Expense Ledger base URL for validating linked expenses in the same workspace.
EXPENSE_SERVICE_URL="http://localhost:3003"
# Generate with: openssl rand -base64 32
BANK_FEED_TOKEN_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
# Run database endpoint tests only against an isolated database; set this to the
# same URL as DATABASE_URL in the test process, never your development database.
# BANK_FEED_TEST_DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/expense_tracker_bank_feed_test?schema=public"
