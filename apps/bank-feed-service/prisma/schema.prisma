generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client-bank-feed"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["bank_feed_sync"]
}

model BankConnection {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  userId          String            @map("user_id")
  institutionId   String            @map("institution_id")
  institutionName String            @map("institution_name")
  accountId       String            @map("account_id")
  accountName     String            @map("account_name")
  accountType     String            @map("account_type")
  accountMask     String?           @map("account_mask")
  currency        String
  accessToken     String            @map("access_token")
  status          ConnectionStatus
  lastSyncAt      DateTime?         @map("last_sync_at")
  tokenExpiresAt  DateTime?         @map("token_expires_at")
  errorMessage    String?           @map("error_message")
  version         Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  transactions    BankTransaction[]
  syncSessions    SyncSession[]

  @@unique([workspaceId, institutionId, accountId])
  @@unique([id, workspaceId])
  @@map("bank_connection")
  @@schema("bank_feed_sync")
}

model SyncSession {
  id                    String            @id @default(uuid())
  workspaceId           String            @map("workspace_id")
  connectionId          String            @map("connection_id")
  status                SyncStatus
  startedAt             DateTime          @map("started_at")
  completedAt           DateTime?         @map("completed_at")
  transactionsFetched   Int               @default(0) @map("transactions_fetched")
  transactionsImported  Int               @default(0) @map("transactions_imported")
  transactionsDuplicate Int               @default(0) @map("transactions_duplicate")
  errorMessage          String?           @map("error_message")
  metadata              Json?
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  transactions          BankTransaction[]
  connection            BankConnection    @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([id, workspaceId, connectionId])
  @@index([workspaceId, connectionId, startedAt])
  @@map("sync_session")
  @@schema("bank_feed_sync")
}

model BankTransaction {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  connectionId    String            @map("connection_id")
  sessionId       String            @map("session_id")
  externalId      String            @map("external_id")
  amount          Decimal           @db.Decimal(20, 6)
  currency        String
  description     String
  merchantName    String?           @map("merchant_name")
  categoryName    String?           @map("category_name")
  transactionDate DateTime          @map("transaction_date")
  postedDate      DateTime?         @map("posted_date")
  status          TransactionStatus
  expenseId       String?           @map("expense_id")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  connection      BankConnection    @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  session         SyncSession       @relation(fields: [sessionId, workspaceId, connectionId], references: [id, workspaceId, connectionId], onDelete: Restrict)

  @@unique([connectionId, externalId])
  @@index([workspaceId, connectionId, transactionDate])
  @@index([workspaceId, status, transactionDate])
  @@index([sessionId, workspaceId, connectionId])
  @@map("bank_transaction")
  @@schema("bank_feed_sync")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  eventType     String            @map("event_type")
  payload       Json
  status        OutboxEventStatus
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")
    retryCount    Int               @default(0) @map("retry_count")
    error         String?
    deliveredTo    String[]          @default([]) @map("delivered_to")
    leaseToken     String?           @map("lease_token")
    leaseExpiresAt DateTime?         @map("lease_expires_at")
    nextAttemptAt  DateTime          @default(now()) @map("next_attempt_at")

  @@index([status, createdAt])
  @@index([aggregateId])
  @@map("outbox_event")
  @@schema("bank_feed_sync")
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
  DELETED

  @@schema("bank_feed_sync")
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL

  @@schema("bank_feed_sync")
}

enum TransactionStatus {
  PENDING
  MATCHED
  IMPORTED
  IGNORED
  DUPLICATE

  @@schema("bank_feed_sync")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER

  @@schema("bank_feed_sync")
}
