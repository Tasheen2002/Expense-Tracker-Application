generator client {
  provider        = "prisma-client-js"
  output   = "../src/generated/prisma-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["bank_feed_sync", "identity_workspace"]
}

model BankConnection {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  userId          String            @map("user_id")
  institutionId   String            @map("institution_id")
  institutionName String            @map("institution_name")
  accountId       String            @map("account_id")
  accountName     String            @map("account_name")
  accountType     String            @map("account_type")
  accountMask     String?           @map("account_mask")
  currency        String
  accessToken     String            @map("access_token")
  status          ConnectionStatus
  lastSyncAt      DateTime?         @map("last_sync_at")
  tokenExpiresAt  DateTime?         @map("token_expires_at")
  errorMessage    String?           @map("error_message")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  transactions    BankTransaction[]
  syncSessions    SyncSession[]

  @@unique([workspaceId, institutionId, accountId])
  @@map("bank_connection")
  @@schema("bank_feed_sync")
}

model SyncSession {
  id                    String            @id @default(uuid())
  workspaceId           String            @map("workspace_id")
  connectionId          String            @map("connection_id")
  status                SyncStatus
  startedAt             DateTime          @map("started_at")
  completedAt           DateTime?         @map("completed_at")
  transactionsFetched   Int               @default(0) @map("transactions_fetched")
  transactionsImported  Int               @default(0) @map("transactions_imported")
  transactionsDuplicate Int               @default(0) @map("transactions_duplicate")
  errorMessage          String?           @map("error_message")
  metadata              Json?
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  transactions          BankTransaction[]
  connection            BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("sync_session")
  @@schema("bank_feed_sync")
}

model BankTransaction {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  connectionId    String            @map("connection_id")
  sessionId       String            @map("session_id")
  externalId      String            @map("external_id")
  amount          Float
  currency        String
  description     String
  merchantName    String?           @map("merchant_name")
  categoryName    String?           @map("category_name")
  transactionDate DateTime          @map("transaction_date")
  postedDate      DateTime?         @map("posted_date")
  status          TransactionStatus
  expenseId       String?           @map("expense_id")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  connection      BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  session         SyncSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalId])
  @@map("bank_transaction")
  @@schema("bank_feed_sync")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  eventType     String            @map("event_type")
  payload       Json
  status        OutboxEventStatus
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")
  retryCount    Int               @default(0) @map("retry_count")
  error         String?

  @@index([status, createdAt])
  @@index([aggregateId])
  @@map("outbox_event")
  @@schema("bank_feed_sync")
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED

  @@schema("bank_feed_sync")
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL

  @@schema("bank_feed_sync")
}

enum TransactionStatus {
  PENDING
  MATCHED
  IMPORTED
  IGNORED
  DUPLICATE

  @@schema("bank_feed_sync")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@schema("bank_feed_sync")
}

model WorkspaceMembership {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, workspaceId])
  @@map("workspace_membership")
  @@schema("identity_workspace")
}
