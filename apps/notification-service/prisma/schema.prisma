generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client-notification"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["notification_dispatch"]
}

model AccountNotificationRequest {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  fingerprint String @db.VarChar(64)
  suppressed Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  notification AccountNotification?
  @@unique([id, userId])
  @@map("account_notification_requests")
  @@schema("notification_dispatch")
}

model AccountNotification {
  id String @id @db.Uuid
  request AccountNotificationRequest @relation(fields: [id, userId], references: [id, userId], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(100)
  title String @db.VarChar(255)
  content String
  readAt DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("account_notifications")
  @@schema("notification_dispatch")
}

model AccountNotificationPreference {
  userId String @id @map("user_id") @db.Uuid
  inAppEnabled Boolean @default(true) @map("in_app_enabled")
  typeSettings Json @default("{}") @map("type_settings")
  @@map("account_notification_preferences")
  @@schema("notification_dispatch")
}

model Notification {
  revision Int @default(0)
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  type        NotificationType
  channel     NotificationChannel
  priority    NotificationPriority @default(MEDIUM)
  title       String               @db.VarChar(255)
  content     String
  data        Json?
  sourceEventFingerprint String? @map("source_event_fingerprint") @db.VarChar(64)
  status      NotificationStatus   @default(PENDING)
  error       String?
  readAt      DateTime?            @map("read_at") @db.Timestamptz(6)
  sentAt      DateTime?            @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  emailDelivery EmailDelivery?

  @@index([recipientId, workspaceId])
  @@index([recipientId, readAt])
  @@index([status])
  @@index([type])
  @@map("notifications")
  @@schema("notification_dispatch")
}

// Permanent receipt, including requests suppressed by preferences.
model NotificationRequest {
  id String @id @db.Uuid
  kind String @db.VarChar(16)
  fingerprint String @db.VarChar(64)
  workspaceId String @map("workspace_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  notificationIds String[] @map("notification_ids") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([workspaceId])
  @@map("notification_requests")
  @@schema("notification_dispatch")
}

model EmailDelivery {
  notificationId String @id @map("notification_id") @db.Uuid
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status String @default("PENDING") @db.VarChar(32)
  attempts Int @default(0)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  // Immutable provider payload captured before the first external call.
  message Json?
  provider String? @db.VarChar(32)
  firstAttemptAt DateTime? @map("first_attempt_at") @db.Timestamptz(6)
  retryDeadline DateTime? @map("retry_deadline") @db.Timestamptz(6)
  error String?
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@map("email_deliveries")
  @@schema("notification_dispatch")
}

model NotificationTemplate {
  revision Int @default(0)
  id              String              @id @default(uuid()) @db.Uuid
  workspaceId     String?             @map("workspace_id") @db.Uuid
  name            String              @db.VarChar(100)
  type            NotificationType
  channel         NotificationChannel
  subjectTemplate String              @map("subject_template") @db.VarChar(255)
  bodyTemplate    String              @map("body_template")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, type, channel])
  @@index([type, channel, isActive])
  @@map("notification_templates")
  @@schema("notification_dispatch")
}

model NotificationPreference {
  revision Int @default(0)
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  emailEnabled Boolean  @default(true) @map("email_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  pushEnabled  Boolean  @default(false) @map("push_enabled")
  typeSettings Json?    @map("type_settings")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@map("notification_preferences")
  @@schema("notification_dispatch")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  eventType     String            @map("event_type")
  payload       Json
  status        OutboxEventStatus
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")
  retryCount    Int               @default(0) @map("retry_count")
  error         String?

  deliveredTo   String[]          @default([]) @map("delivered_to")
  leaseToken    String?           @map("lease_token")
  leaseExpiresAt DateTime?        @map("lease_expires_at")
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")

  @@index([status, createdAt])
  @@index([aggregateId])
  @@index([status, leaseExpiresAt])
  @@index([status, nextAttemptAt])
  @@map("outbox_event")
  @@schema("notification_dispatch")
}

enum NotificationType {
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  APPROVAL_REQUIRED
  BUDGET_ALERT
  INVITATION
  SYSTEM_ALERT

  @@schema("notification_dispatch")
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH

  @@schema("notification_dispatch")
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@schema("notification_dispatch")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ

  @@schema("notification_dispatch")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER

  @@schema("notification_dispatch")
}
