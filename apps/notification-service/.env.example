# ============================================
# Notification Service — Configuration
# ============================================
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/expense_tracker_notification?schema=public"
PORT=3008

# Configure both to enable the durable email worker. Use a verified sender.
# Leave both unset to pause email delivery; queued intent remains durable.
RESEND_API_KEY=
NOTIFICATION_EMAIL_PROVIDER=resend
# For local capture: set NOTIFICATION_EMAIL_PROVIDER=mailpit (never production).
MAILPIT_URL=http://localhost:8025
NOTIFICATION_EMAIL_FROM=
INTERNAL_API_KEY=
IDENTITY_SERVICE_URL=http://localhost:3002
