# ============================================
# Expense & Budgeting Service — Configuration
# ============================================

# Service-specific database
DATABASE_URL="postgresql://postgres:yourpassword@127.0.0.1:5432/expense_tracker_expense?schema=public"

# Server Port
PORT=3003

# Environment Mode (development, test, production)
NODE_ENV=development

# Internal Service-to-Service API Key and Cron Secret
INTERNAL_API_KEY="dev-internal-key-change-in-prod"
CRON_SECRET="dev-cron-secret-change-in-prod"

# Downstream Service URLs
IDENTITY_SERVICE_URL="http://localhost:3002"
AUDIT_SERVICE_URL="http://localhost:3009"
NOTIFICATION_SERVICE_URL="http://localhost:3008"

# Transactional Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=5
OUTBOX_LEASE_DURATION_MS=30000

# Development Authentication Bypass (Set to "true" only in local dev without Identity running)
ALLOW_INSECURE_INTERNAL_AUTH=false
