# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Each microservice has its own database, configured in its own .env file:
#   apps/identity-access-service/.env     → expense_tracker_identity
#   apps/expense-budgeting-service/.env   → expense_tracker_expense
#   apps/categorization-service/.env      → expense_tracker_categorization
#   apps/approval-policy-service/.env     → expense_tracker_approval
#   apps/bank-feed-service/.env           → expense_tracker_bank_feed
#   apps/receipt-vault-service/.env       → expense_tracker_receipt
#   apps/notification-service/.env        → expense_tracker_notification
#   apps/audit-compliance-service/.env    → expense_tracker_audit
#
# Run scripts/setup-databases.sql to create all databases.
# Docker Compose requires explicit database/cache passwords; generate unique values.
# Use hexadecimal values here so the PostgreSQL URL needs no escaping.
POSTGRES_PASSWORD="replace-with-random-hex-password"
REDIS_PASSWORD="replace-with-random-hex-password"

# ============================================
# SERVICE DISCOVERY (Downstream Service URLs)
# ============================================
IDENTITY_SERVICE_URL="http://localhost:3002"
EXPENSE_SERVICE_URL="http://localhost:3003"
CATEGORIZATION_SERVICE_URL="http://localhost:3004"
APPROVAL_SERVICE_URL="http://localhost:3005"
BANK_FEED_SERVICE_URL="http://localhost:3006"
RECEIPT_SERVICE_URL="http://localhost:3007"
NOTIFICATION_SERVICE_URL="http://localhost:3008"
AUDIT_SERVICE_URL="http://localhost:3009"

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate secure keys via:
#   JWT_SECRET: openssl rand -base64 32
#   INTERNAL_API_KEY: openssl rand -hex 32
JWT_SECRET="replace-with-secure-random-jwt-secret-minimum-32-chars"
INTERNAL_API_KEY="replace-with-secure-random-internal-api-key"
# Generate with: openssl rand -base64 32
BANK_FEED_TOKEN_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
# HTTPS transaction endpoint; see apps/bank-feed-service/.env.example for its response contract.
BANK_FEED_PROVIDER_URL=""
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Password hashing (bcrypt rounds)
BCRYPT_ROUNDS=10

# ============================================
# FILE STORAGE
# ============================================
# Options: "local" | "s3" | "cloudinary"
STORAGE_PROVIDER="local"

# Local Storage
LOCAL_STORAGE_PATH="./uploads"

# AWS S3 (if using S3)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME=""

# Cloudinary (if using Cloudinary)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ============================================
# EMAIL SERVICE (Future Phase)
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@expense-tracker.com"

# ============================================
# WORKER & BACKGROUND JOBS
# ============================================
# Redis for queue management
REDIS_URL="redis://localhost:6379"

# Outbox polling interval (milliseconds)
OUTBOX_POLL_INTERVAL=5000

# ============================================
# CORS & SECURITY
# ============================================
# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:3000"

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW="15m"

# Gateway ingress quota and explicit proxy trust (single-instance deployment).
GATEWAY_RATE_LIMIT_MAX=300
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_TRUSTED_PROXY_IPS=
IDENTITY_TRUSTED_PROXY_IPS=

# ============================================
# OCR SERVICE (Future Phase)
# ============================================
# OCR_PROVIDER="aws-textract" | "google-vision" | "tesseract"
# AWS_TEXTRACT_REGION=""
# GOOGLE_VISION_KEY=""
